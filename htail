#!/usr/bin/env python3
"""Development launcher for a source checkout.

Published releases use the self-contained bundle produced by tools/build_release.py.
This launcher deliberately cannot install itself into ~/.local/bin because it
requires the adjacent repository ``src`` tree.
"""
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parent
SRC = ROOT / "src"
sys.path.insert(0, str(SRC))

from htail_app.app import main

if __name__ == "__main__":
    if "--install" in sys.argv[1:]:
        print(
            "htail: the repository ./htail file is a source-checkout launcher and cannot be installed. "
            "Use the published release asset, or build one with tools/build_release.py.",
            file=sys.stderr,
        )
        raise SystemExit(2)
    argv = list(sys.argv[1:])
    if "--no-self-install-prompt" not in argv:
        argv.append("--no-self-install-prompt")
    raise SystemExit(main(argv))
