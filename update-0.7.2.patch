+            return False
+        with self._lock:
+            if self._thread is not None and self._thread.is_alive():
+                return False
+            if self._done and not force:
+                return False
+            self._done = False
+            self._error = None
+            if force:
+                self._release = None
+            self._thread = threading.Thread(
